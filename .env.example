# Skopiuj do .env.local i uzupełnij. Wszystkie zmienne są opcjonalne.

# Publiczny adres strony (SEO, Open Graph, sitemap).
# Na Vercel bez tej zmiennej użyty zostanie automatycznie adres produkcyjny.
NEXT_PUBLIC_SITE_URL=

# Wysyłka formularza kontaktowego przez https://resend.com
RESEND_API_KEY=
# Adres, na który mają trafiać wiadomości
CONTACT_TO_EMAIL=sk.devs.contact@gmail.com
# Nadawca ze zweryfikowanej domeny, np. "Formularz <formularz@twojadomena.pl>"
CONTACT_FROM_EMAIL=
